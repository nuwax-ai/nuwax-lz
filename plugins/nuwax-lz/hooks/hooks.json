{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://desk-buddy.nuwao.com/api/agent-cli/v1/hooks",
            "headers": {
              "Authorization": "Bearer $CLAUDE_PLUGIN_OPTION_NUWAX_LZ_TOKEN",
              "Content-Type": "application/json"
            },
            "allowedEnvVars": ["CLAUDE_PLUGIN_OPTION_NUWAX_LZ_TOKEN"],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "http",
            "url": "https://desk-buddy.nuwao.com/api/agent-cli/v1/hooks",
            "headers": {
              "Authorization": "Bearer $CLAUDE_PLUGIN_OPTION_NUWAX_LZ_TOKEN",
              "Content-Type": "application/json"
            },
            "allowedEnvVars": ["CLAUDE_PLUGIN_OPTION_NUWAX_LZ_TOKEN"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
